# Konfigurasi WhatsApp Bridge
# Salin file ini menjadi ".env" lalu isi nilainya

# URL Backend FastAPI (jangan diubah jika dijalankan di komputer yang sama)
CHAT_BACKEND_URL=http://localhost:8001/api/chat

# Nomor WhatsApp yang boleh dibalas otomatis oleh bot
# Format: kode negara + nomor tanpa tanda + (pisahkan dengan koma jika lebih dari 1)
# Contoh: 6281234567890,6289876543210
# Kosongkan untuk mengizinkan SEMUA nomor
ALLOWED_NUMBERS=

# Timeout pemanggilan backend dalam milidetik (default: 240000 = 4 menit)
BACKEND_TIMEOUT_MS=240000

# Pesan fallback jika backend tidak merespons / error
FALLBACK_MESSAGE=Mohon maaf, sistem sedang tidak dapat memproses permintaan Anda. Silakan hubungi kami di (0727) 322241.
