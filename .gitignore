# ════════════════════════════════════════════════════════════════
#  .gitignore — Chatbot BPS Kabupaten Lampung Selatan
#  File ini melindungi data sensitif agar TIDAK terupload ke GitHub
# ════════════════════════════════════════════════════════════════

# Sesi login WhatsApp (berisi kunci enkripsi & token pribadi)
wa-bridge/auth_state/

# File konfigurasi berisi nomor HP, URL, API Key
.env
**/.env

# Data markdown yang berisi data sensus & statistik BPS
llamaindex-docs-agent/backend/data/sensus/
llamaindex-docs-agent/backend/data/docs/

# Folder ini dibuat otomatis saat chatbot pertama dijalankan
llamaindex-docs-agent/backend/storage/
llamaindex-docs-agent/backend/pipeline_storage/

# Tidak perlu di-upload, cukup jalankan: npm install & pip install
wa-bridge/node_modules/
llamaindex-docs-agent/frontend/node_modules/
llamaindex-docs-agent/backend/venv/
llamaindex-docs-agent/backend/.venv/

logs/
*.log
wa-bridge/charts/*.png

__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
